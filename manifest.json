{
  "manifest_version": 3,
  "name": "E-ink",
  "version": "2.0.0",
  "description": "Grayscale, low-glare e-ink look for every site that follows the Mac's light or dark appearance.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "bg.js"
  },
  "action": {
    "default_title": "E-ink",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["eink.css"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
